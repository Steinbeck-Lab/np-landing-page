<%- include('partials/head', { title: 'Administrator sign in', isAdmin: true }) %>
<main id="main" class="login-layout">
  <a class="brand" href="/"><img src="/assets/logos/natural-products.webp" width="58" height="45" alt=""><span>Natural Products <span class="brand-sub">CONTENT STUDIO</span></span></a>
  <section class="panel login-panel" aria-labelledby="login-title"><p class="eyebrow">WELCOME BACK</p><h1 id="login-title">A little care.<br>A living ecosystem.</h1><p>Sign in to manage resources and website content.</p>
  <% if (error) { %><p class="notice notice-error" role="alert"><%= error %></p><% } %>
  <form method="post" action="/admin/login" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Username<input name="username" autocomplete="username" required maxlength="60"></label>
    <label>Password<input name="password" type="password" autocomplete="current-password" required maxlength="200"></label>
    <button class="button" type="submit">Sign in &#8594;</button>
  </form></section><a class="text-link" href="/">&#8592; Back to the website</a>
</main></body></html>
